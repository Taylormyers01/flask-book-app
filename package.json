{
  "name": "mybookapp",
  "productName": "My Book App",
  "version": "1.0.0",
  "main": "main.js",
  "author": "git_hub_taylormyers01",
  "description": "Python flask-app",
  "scripts": {
    "start": "electron-forge start",
    "make": "electron-forge make",
    "package": "electron-forge package"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.2",
    "@electron-forge/maker-deb": "^7.8.2",
    "@electron-forge/maker-rpm": "^7.8.2",
    "@electron-forge/maker-squirrel": "^7.8.2",
    "@electron-forge/maker-zip": "^7.8.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.2",
    "@electron-forge/plugin-fuses": "^7.8.2",
    "@electron/fuses": "^1.8.0",
    "electron": "^28.0.0"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "icon": "./assets/vecteezy/book-icon-pixel"
      },
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "mybookapp",
            "setupIcon": "./assets/vecteezy/book-icon-pixel.ico",
            "iconUrl": "file://./assets/vecteezy/book-icon-pixel.ico",
            "win32metadata": {
              "CompanyName": "Taylor Myers",
              "OriginalFilename": "MyBookApp.exe",
              "ProductName": "My Book App",
              "FileDescription": "My Book App Desktop Application",
              "CreateDesktopShortcut": true
            }
          }
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": ["darwin"]
        },
        {
          "name": "@electron-forge/maker-deb",
          "config": {}
        },
        {
          "name": "@electron-forge/maker-rpm",
          "config": {}
        }
      ]
    }
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  }
}
